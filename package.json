{
  "name": "@olamaelcu/atproto-svelte",
  "version": "0.1.0",
  "type": "module",
  "description": "ATProto OAuth client and identity resolution for SvelteKit with Tanstack Query caching",
  "license": "MPL-2.0",
  "homepage": "https://forge.blacksky.community/olamaelcu.net/atproto-svelte",
  "repository": {
    "type": "git",
    "url": "git@knot.olamaelcu.net:olamaelcu.net/atproto-svelte.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "svelte": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "@tanstack/svelte-query": "^5.0.0"
  },
  "dependencies": {
    "@atproto/api": "^0.13.0",
    "@atproto/common": "^0.4.0",
    "@atproto/oauth-client-node": "^0.1.0",
    "@atproto/oauth-types": "^0.1.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "jose": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@tanstack/svelte-query": "^5.0.0",
    "@testing-library/svelte": "^5.0.0",
    "eslint": "^9.0.0",
    "msw": "^2.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
