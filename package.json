{
  "name": "@olamaelcu/atproto-svelte",
  "version": "0.6.10",
  "type": "module",
  "sideEffects": false,
  "description": "ATProto OAuth client and identity resolution for SvelteKit with Tanstack Query caching",
  "license": "MPL-2.0",
  "keywords": [
    "atproto",
    "bluesky",
    "oauth",
    "svelte",
    "sveltekit",
    "identity",
    "did"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://forge.blacksky.community/olamaelcu.net/atproto-svelte",
  "repository": {
    "type": "git",
    "url": "git@knot.olamaelcu.net:olamaelcu.net/atproto-svelte.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "svelte": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2.5.0",
    "@tanstack/svelte-query": "^6.0.0",
    "svelte": ">=5.25.0"
  },
  "dependencies": {
    "@atproto/api": "^0.20.0",
    "@atproto/jwk": "^0.7.0",
    "@atproto/jwk-jose": "^0.2.0",
    "@atproto/oauth-client-node": "^0.4.0",
    "@libsql/client": "^0.14.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@atproto/oauth-client": "^0.7.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-node": "^5.5.0",
    "@sveltejs/kit": "^2.60.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tanstack/svelte-query": "^6.1.0",
    "@testing-library/svelte": "^5.3.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "^3.17.1",
    "msw": "^2.14.0",
    "svelte": "^5.55.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
